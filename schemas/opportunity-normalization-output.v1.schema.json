{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.dev/schemas/opportunity-normalization-output.v1.schema.json",
  "title": "Opportunity normalization output v1",
  "type": "object",
  "required": ["contract_name", "contract_version", "schema_version", "status", "opportunity", "warnings", "provenance"],
  "properties": {
    "contract_name": { "const": "career-ops.opportunity-normalization-result" },
    "contract_version": { "const": 1 },
    "schema_version": { "const": 1 },
    "status": { "enum": ["ok", "review"] },
    "opportunity": {
      "type": "object",
      "required": ["id", "observed", "normalized", "inferred", "unresolved"],
      "properties": {
        "id": { "type": "string", "pattern": "^opp_[0-9a-f]{24}$" },
        "observed": {
          "type": "object",
          "required": ["company", "title", "canonical_url"],
          "properties": {
            "company": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"] },
            "canonical_url": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "normalized": {
          "type": "object",
          "required": ["company", "title", "canonical_url", "requirements"],
          "properties": {
            "company": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"] },
            "canonical_url": { "type": ["string", "null"] },
            "requirements": {
              "type": "array",
              "maxItems": 30,
              "items": { "type": "string", "maxLength": 500 }
            }
          },
          "additionalProperties": false
        },
        "inferred": {
          "type": "object",
          "required": ["location", "compensation", "seniority", "domains"],
          "properties": {
            "location": {
              "type": "object",
              "required": ["remote", "hybrid", "onsite", "evidence"],
              "properties": {
                "remote": { "type": "boolean" },
                "hybrid": { "type": "boolean" },
                "onsite": { "type": "boolean" },
                "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            },
            "compensation": {
              "type": "object",
              "required": ["currency", "min", "max", "period", "confidence", "evidence", "rule_id"],
              "properties": {
                "currency": { "type": ["string", "null"] },
                "min": { "type": ["number", "null"], "minimum": 0 },
                "max": { "type": ["number", "null"], "minimum": 0 },
                "period": { "enum": ["annual", "hourly", "unknown"] },
                "confidence": { "enum": ["high", "medium", "low"] },
                "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                "rule_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "seniority": { "$ref": "#/$defs/inference" },
            "domains": {
              "type": "array",
              "items": { "$ref": "#/$defs/inference" }
            }
          },
          "additionalProperties": false
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "reason"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_type", "source_id", "observed_at", "content_sha256", "implementation", "taxonomy"],
      "properties": {
        "source_type": { "type": "string" },
        "source_id": { "type": ["string", "null"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "implementation": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "career-ops.opportunity-normalization" },
            "version": { "const": 1 }
          },
          "additionalProperties": false
        },
        "taxonomy": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "career-ops.opportunity-taxonomy" },
            "version": { "const": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "inference": {
      "type": "object",
      "required": ["value", "confidence", "evidence", "rule_id"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rule_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
