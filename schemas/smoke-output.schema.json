{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.dev/schemas/smoke-output.v1.schema.json",
  "title": "CareerOps bootstrap smoke output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_name", "contract_version", "message", "content_hash"],
  "properties": {
    "contract_name": { "const": "career-ops.smoke-result" },
    "contract_version": { "const": 1 },
    "message": { "type": "string", "minLength": 1, "maxLength": 120 },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
