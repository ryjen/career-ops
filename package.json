{
  "name": "@ryjen/career-ops",
  "version": "0.0.0-development",
  "description": "Deterministic, evidence-driven career operations contracts and core algorithms.",
  "license": "MPL-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "exports": {
    ".": "./src/index.js",
    "./contracts/smoke": "./src/contracts/smoke.js"
  },
  "bin": {
    "career-ops": "./src/cli.js"
  },
  "files": [
    "src/",
    "schemas/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "setup": "npm ci --ignore-scripts",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-source.mjs",
    "schema:validate": "node scripts/validate-schemas.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "verify": "npm run format:check && npm run lint && npm run schema:validate && npm test && npm run build && npm run pack:check"
  }
}
